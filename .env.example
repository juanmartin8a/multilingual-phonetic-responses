# Copy to .env; load with bun --env-file=.env. Never commit real credentials.
# Obtain a DEVELOPMENT deploy key from the SAPO development Convex dashboard.
# Settings and non-secret account identifiers belong in config/transcriptions.yml or config/respellings.yml.
SAPO_CONVEX_DEV_KEY=dev:YOUR-DEVELOPMENT-NAME|YOUR-SECRET
# Account > AI Gateway > Run; scope to your Cloudflare account.
CLOUDFLARE_API_TOKEN=YOUR-SECRET
# Store your OpenAI key in Cloudflare AI Gateway > Provider Keys (alias: default).
# No OPENAI_API_KEY is needed locally. OpenAI bills inference directly.
